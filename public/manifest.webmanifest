{
    "name": "Web eReader",
    "short_name": "eReader",
    "description": "A local-first EPUB reader and speed reader. Your books stay on your device.",
    "start_url": "./",
    "scope": "./",
    "display": "standalone",
    "background_color": "#fbfaf8",
    "theme_color": "#fbfaf8",
    "lang": "en",
    "dir": "ltr",
    "categories": ["books", "education"],
    "icons": [
        {
            "src": "icons/icon-192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "icons/icon-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "icons/maskable-192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "maskable"
        },
        {
            "src": "icons/maskable-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "maskable"
        }
    ],
    "file_handlers": [
        {
            "action": "./",
            "accept": {
                "application/epub+zip": [".epub"]
            }
        }
    ],
    "launch_handler": {
        "client_mode": "focus-existing"
    }
}
